# Discord Application Client ID
# Create one at https://discord.com/developers/applications
# See README.md for step-by-step setup guide
DISCORD_CLIENT_ID=your_client_id_here

# Path to Hermes Agent SQLite state database
# Default: C:\Users\<you>\AppData\Local\hermes\state.db
# For per-profile: C:\Users\<you>\AppData\Local\hermes\<profile>\state.db
HERMES_STATE_DB_PATH=C:\Users\F\AppData\Local\hermes\state.db

# Polling interval in milliseconds (default: 10000 = 10s)
# Discord RPC rate limit is 1 update per 15s, so don't go below 15000
POLL_INTERVAL=10000

# Optional: Hermes API server URL (future-proofing)
# If set, the tool will try this before falling back to SQLite
# HERMES_API_URL=http://localhost:3578/api

# Optional: Path to hermes-companion activity state file (future-proofing)
# HERMES_ACTIVITY_FILE=C:\Users\F\.hermes\state\activity.json

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info
