# Discord Application Client ID (required)
# Create one at https://discord.com/developers/applications
# This is a working Client ID included in the repo; replace with your own if needed.
DISCORD_CLIENT_ID=1512988178229887218

# Path to Hermes Agent SQLite state database (fallback source)
# Uses Windows %LOCALAPPDATA% env var — no hardcoded paths
HERMES_STATE_DB_PATH=%LOCALAPPDATA%\hermes\state.db

# Polling interval in milliseconds (default: 2000 = 2s)
# This controls how often the companion CHECKS for state changes.
# Discord's 15s rate limit is handled separately in discord-rpc.js —
# it only limits how often we SEND updates, not how often we READ.
# Lower values = faster detection of session changes.
POLL_INTERVAL=2000

# Stale session threshold in seconds (default: 1800 = 30 min)
# Sessions/hooks with no activity in this window are treated as idle
STALE_THRESHOLD_SECONDS=1800

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# ── Hook Activity File (set automatically if hook is installed) ──
# If the Hermes Gateway Hook is installed at ~/.hermes/hooks/discord-rpc-activity/,
# the hook writes real-time activity to its activity.json file.
# No config needed — the companion auto-detects it.
# See README.md → "Installing the Gateway Hook" for setup.

# ── Multi-Agent Profile Exclusion ──
# The companion scans ALL Hermes profile databases to find the most
# recently active agent. Profiles listed here are skipped.
# Comma-separated. Example: routing-agent,hermes-admin
# EXCLUDED_PROFILES=routing-agent