# Discord Application Client ID (required)
# Create one at https://discord.com/developers/applications
# See README.md for step-by-step setup guide
DISCORD_CLIENT_ID=your_client_id_here

# Polling interval in milliseconds (default: 2000 = 2s)
# How often the companion checks for state changes.
# Discord's 15s rate limit is handled separately — reading more often is free.
POLL_INTERVAL=2000

# Stale session threshold in seconds (default: 1800 = 30 min)
# Sessions with no activity in this window are treated as idle
STALE_THRESHOLD_SECONDS=1800

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Multi-agent profile exclusion (optional)
# Comma-separated list of profiles to skip during multi-agent scanning.
# Example: EXCLUDED_PROFILES=routing-agent,hermes-admin
# EXCLUDED_PROFILES=
