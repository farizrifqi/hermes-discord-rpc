; hermes-discord-rpc.service
; ═══════════════════════════════════════════════════════════
; Windows Service Configuration using NSSM (Non-Sucking Service Manager)
; ═══════════════════════════════════════════════════════════
;
; Install NSSM from https://nssm.cc/download
; Then run these commands as Administrator:
;
;   nssm install HermesDiscordRPC "C:\Program Files\nodejs\node.exe" "C:\Users\F\hermes-discord-rpc\src\index.js"
;   nssm set HermesDiscordRPC AppDirectory "C:\Users\F\hermes-discord-rpc"
;   nssm set HermesDiscordRPC AppEnvironmentExtra "NODE_ENV=production"
;   nssm set HermesDiscordRPC Start SERVICE_AUTO_START
;   nssm start HermesDiscordRPC
;
; To uninstall:
;   nssm stop HermesDiscordRPC
;   nssm remove HermesDiscordRPC confirm
;
; ═══════════════════════════════════════════════════════════
; Alternative: Windows Task Scheduler XML
; ═══════════════════════════════════════════════════════════
; Save as hermes-discord-rpc-task.xml and import with:
;   schtasks /create /xml hermes-discord-rpc-task.xml /tn "Hermes Discord RPC"
;
; <?xml version="1.0" encoding="UTF-16"?>
; <Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
;   <RegistrationInfo>
;     <Description>Hermes Agent Discord Rich Presence Companion</Description>
;   </RegistrationInfo>
;   <Triggers>
;     <LogonTrigger>
;       <Enabled>true</Enabled>
;     </LogonTrigger>
;   </Triggers>
;   <Principals>
;     <Principal id="Author">
;       <LogonType>InteractiveToken</LogonType>
;       <RunLevel>LeastPrivilege</RunLevel>
;     </Principal>
;   </Principals>
;   <Settings>
;     <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
;     <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
;     <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
;     <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
;     <Enabled>true</Enabled>
;   </Settings>
;   <Actions>
;     <Exec>
;       <Command>node</Command>
;       <Arguments>src/index.js</Arguments>
;       <WorkingDirectory>C:\Users\F\hermes-discord-rpc</WorkingDirectory>
;     </Exec>
;   </Actions>
; </Task>
